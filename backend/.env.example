# App
APP_NAME=resume-ai-analyzer
APP_ENV=dev
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Qwen (DashScope 兼容模式)
QWEN_API_KEY=sk-xxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Docker Redis（与项目根目录 docker-compose.yml 一致）
# 本机：127.0.0.1；后端若在别的机器，填 Redis 所在服务器 IP
REDIS_HOST=192.168.100.131
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
CACHE_TTL_PARSE=86400
CACHE_TTL_MATCH=21600

# Upload limits
MAX_UPLOAD_MB=5
